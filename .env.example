# Copy to .env.local; never put real credentials in this template.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MONGODB_URI=
MONGODB_DB=finn
FINN_ACCESS_KEY=
# Optional: enables the authenticated daily Vercel sync job.
CRON_SECRET=
# Comma-separated default companies for scheduled sync, if not saved from the UI.
FINN_SYNC_TICKERS=RELIANCE,TCS,HDFCBANK,INFY,BHARTIARTL,LT,SUNPHARMA,TITAN,MARUTI,ULTRACEMCO,BAJFINANCE,TRENT,PERSISTENT,POLYCAB,KPITTECH,APLAPOLLO,CDSL,DIXON

# Production canonical URL, e.g. https://finn.your-domain.com (no trailing path).
FINN_APP_URL=
# Production requires MongoDB by default. Durable local override is for isolated tests/self-hosting only.
FINN_ALLOW_LOCAL_STORAGE=false

# Optional: model for document extraction; defaults to GROQ_MODEL.
GROQ_EXTRACTION_MODEL=
