{
  "name": "finn-investment-agent",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/integration.mjs",
    "check:production": "node scripts/preflight.mjs",
    "check:release": "npm test && npm run build && npm run test:integration && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "mongodb": "6.20.0",
    "next": "16.4.3",
    "pdf-parse": "1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "engines": {
    "node": ">=22.16.0 <25"
  }
}
